/* Emoji 角色 */
.emoji { font-size:90px; line-height:1; filter:drop-shadow(0 6px 10px rgba(0,0,0,.2)); }
.actor:hover .emoji { animation:wiggle .5s; }
@keyframes wiggle { 0%,100%{transform:rotate(0)} 25%{transform:rotate(-6deg)} 75%{transform:rotate(6deg)} }

/* 水龍頭 + 水流 */
.faucet-zone { position:absolute; bottom:40px; left:50%; transform:translateX(-50%); text-align:center; }
.faucet-wrap { position:relative; width:120px; height:220px; margin:0 auto; }

/* 水柱 */
.stream { position:absolute; top:52px; left:50%; transform:translateX(-50%); width:0; height:0;
 background:linear-gradient(#bdeeff,#5fc6 e8); border-radius:0 0 6px 6px; overflow:hidden; }
.stream { background:linear-gradient(#bdeeff,#4fb8dd); }
.stream.on { width:12px; height:120px; animation:streamFlow .5s linear infinite; }
@keyframes streamFlow {
 0%{box-shadow:inset 0 0 0 rgba(255,255,255,0);}
 50%{box-shadow:inset 0 -40px 20px -30px rgba(255,255,255,.6);}
 100%{box-shadow:inset 0 0 0 rgba(255,255,255,0);}
}

/* 水盆 + 積水 */
.basin { position:absolute; bottom:0; left:50%; transform:translateX(-50%); width:110px; height:46px;
 background:#d7dde3; border-radius:0 0 40px 40px; overflow:hidden; box-shadow:inset 0 4px 6px rgba(0,0,0,.1); }
.basin .fill { position:absolute; bottom:0; left:0; width:100%; height:0;
 background:linear-gradient(#9fe0f5,#4fb8dd); transition:height 1.2s ease; opacity:.9; }
.basin .fill::after { content:""; position:absolute; top:0; left:0; width:200%; height:8px;
 background:radial-gradient(circle,rgba(255,255,255,.6) 2px,transparent 3px) repeat-x; background-size:14px 8px;
 animation:ripple 1.5s linear infinite; }
@keyframes ripple { to{transform:translateX(-14px);} }

/* 水花 */
.splash { position:absolute; bottom:40px; left:50%; width:6px; height:6px; border-radius:50%;
 background:#bdeeff; opacity:0; pointer-events:none; }
.splash.go { animation:splashUp .6s ease-out forwards; }
@keyframes splashUp {
 0%{opacity:1; transform:translate(0,0) scale(1);}
 100%{opacity:0; transform:translate(var(--dx),-40px) scale(.3);}
}
