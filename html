<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>一滴水的旅行</title>
<style>
 * { margin:0; padding:0; box-sizing:border-box; }
 html,body { height:100%; font-family:"Segoe UI","PingFang TC","Microsoft JhengHei",sans-serif; overflow:hidden; background:#aee3f0; }
 #app { position:relative; width:100%; height:100vh; }

 .scene { position:absolute; inset:0; opacity:0; pointer-events:none; transition:opacity .8s ease; display:flex; flex-direction:column; }
 .scene.active { opacity:1; pointer-events:auto; }

 .hud { position:absolute; top:0; left:0; right:0; z-index:30; padding:18px 24px; display:flex; justify-content:space-between; align-items:flex-start; pointer-events:none; }
 .title { background:rgba(255,255,255,.75); padding:10px 18px; border-radius:16px; backdrop-filter:blur(4px); box-shadow:0 4px 14px rgba(0,0,0,.08); }
 .title h2 { font-size:20px; color:#1b6b8c; }
 .title p { font-size:13px; color:#3a7a94; margin-top:2px; }
 .tip { background:rgba(27,107,140,.9); color:#fff; padding:8px 16px; border-radius:14px; font-size:14px; max-width:260px; box-shadow:0 4px 14px rgba(0,0,0,.15); }

 .btn { pointer-events:auto; cursor:pointer; border:none; background:#1b8cae; color:#fff; padding:12px 26px; border-radius:30px; font-size:16px; box-shadow:0 6px 16px rgba(27,140,174,.4); transition:transform .15s, background .2s; }
 .btn:hover { transform:translateY(-2px); background:#1b6b8c; }
 .btn.ghost { background:rgba(255,255,255,.9); color:#1b6b8c; }

 /* 開場 */
 #start { background:linear-gradient(180deg,#bfeef7,#8fd6e8); z-index:40; align-items:center; justify-content:center; text-align:center; }
 #start h1 { font-size:46px; color:#105a78; letter-spacing:4px; }
 #start .sub { font-size:17px; color:#2d7792; margin:14px 0 30px; }
 .drop { width:34px; height:44px; background:#4fb8dd; border-radius:50% 50% 50% 50% / 60% 60% 40% 40%; position:relative; margin:0 auto 20px; animation:bob 2.4s ease-in-out infinite; box-shadow:inset -6px -8px 0 rgba(255,255,255,.35); transform:rotate(45deg); }
 .drop::after{content:"";position:absolute;top:30%;left:28%;width:8px;height:8px;background:rgba(255,255,255,.7);border-radius:50%;}
 @keyframes bob { 0%,100%{transform:rotate(45deg) translateY(0);} 50%{transform:rotate(45deg) translateY(-12px);} }

 /* 第一站 */
 #s1 { background:linear-gradient(180deg,#cdeafc 0%,#cdeafc 55%,#bfe6bf 55%,#a8d9a0 100%); }
 .yard { flex:1; position:relative; }
 .actor { position:absolute; cursor:pointer; text-align:center; transition:transform .15s; }
 .actor:hover { transform:scale(1.06); }
 .actor .lbl { margin-top:6px; font-size:13px; background:#fff; padding:3px 10px; border-radius:10px; color:#1b6b8c; opacity:0; transition:opacity .25s; box-shadow:0 2px 6px rgba(0,0,0,.1); }
 .actor.show .lbl { opacity:1; }
 .faucet-zone { position:absolute; bottom:30px; left:50%; transform:translateX(-50%); text-align:center; }
 .water-stream { width:10px; height:0; background:linear-gradient(#9fe0f5,#4fb8dd); margin:0 auto; border-radius:6px; transition:height .5s; }

 /* 第二站 canvas */
 #s2 { background:linear-gradient(180deg,#5a4634,#3c2f22); }
 #s3 { background:linear-gradient(180deg,#bfeef7 0%,#dff6e4 100%); }
 canvas { flex:1; display:block; width:100%; }

 .progress { position:absolute; bottom:24px; left:50%; transform:translateX(-50%); width:260px; height:14px; background:rgba(255,255,255,.4); border-radius:10px; overflow:hidden; z-index:20; }
 .progress i { display:block; height:100%; width:0; background:linear-gradient(90deg,#6fd1ef,#2b9fc4); transition:width .3s; }
 .nextwrap { position:absolute; bottom:60px; left:50%; transform:translateX(-50%); z-index:25; opacity:0; pointer-events:none; transition:opacity .4s; }
 .nextwrap.on { opacity:1; pointer-events:auto; }

 /* 結尾 */
 #end { background:linear-gradient(180deg,#bfeef7,#dff6e4); align-items:center; justify-content:center; text-align:center; }
 #end h1 { font-size:34px; color:#105a78; }
 #end p { font-size:16px; color:#2d7792; margin:16px 0 28px; max-width:460px; }

 .fade { position:absolute; inset:0; background:#4fb8dd; opacity:0; pointer-events:none; z-index:50; transition:opacity .5s; }
 .fade.on { opacity:1; }
</style>
</head>
<body>
<div id="app">

 <!-- 轉場遮罩 -->
 <div class="fade" id="fade"></div>

 <!-- 開場 -->
 <section class="scene active" id="start">
 <div class="drop"></div>
 <h1>一滴水的旅行</h1>
 <div class="sub">從家庭到河川，看看水如何循環與淨化</div>
 <button class="btn" onclick="go('s1')">開始旅程</button>
 </section>

 <!-- 第一站 -->
 <section class="scene" id="s1">
 <div class="hud">
 <div class="title"><h2>第一站 · 家的用水日常</h2><p>點擊人物與動物，看看他們怎麼用水</p></div>
 <div class="tip" id="s1tip">點點看三個角色吧！</div>
 </div>
 <div class="yard">
 <!-- 姥姥刷牙 -->
 <div class="actor" style="top:28%;left:14%" onclick="act(this,'s1a')">
 <svg width="90" height="130" viewBox="0 0 90 130">
 <ellipse cx="45" cy="60" rx="22" ry="30" fill="#f6c6a8"/>
 <circle cx="45" cy="34" r="20" fill="#f6c6a8"/>
 <path d="M25 30 q20 -22 40 0 q-20 -8 -40 0" fill="#dcdcdc"/>
 <rect x="30" y="85" width="30" height="40" rx="10" fill="#e98fb0"/>
 <circle cx="39" cy="33" r="2.5" fill="#333"/><circle cx="51" cy="33" r="2.5" fill="#333"/>
 <g class="brush"><rect x="58" y="36" width="20" height="4" rx="2" fill="#2b9fc4"/><rect x="74" y="34" width="6" height="8" rx="2" fill="#fff"/></g>
 </svg>
 <div class="lbl">刷牙也會用水 🪥</div>
 </div>
 <!-- 老爺爺澆水 -->
 <div class="actor" style="top:40%;left:46%" onclick="act(this,'s1b')">
 <svg width="100" height="140" viewBox="0 0 100 140">
 <ellipse cx="45" cy="70" rx="22" ry="30" fill="#9cc">
 </ellipse>
 <circle cx="45" cy="40" r="20" fill="#f6c6a8"/>
 <path d="M26 40 q19 -10 38 0 q-19 -4 -38 0" fill="#eee"/>
 <path d="M33 48 q12 8 24 0" stroke="#bbb" fill="none" stroke-width="3"/>
 <rect x="33" y="95" width="26" height="35" rx="8" fill="#7a9bbf"/>
 <circle cx="39" cy="40" r="2.5" fill="#333"/><circle cx="51" cy="40" r="2.5" fill="#333"/>
 <g class="can"><rect x="66" y="55" width="22" height="18" rx="4" fill="#4fae7a"/><rect x="85" y="50" width="4" height="12" fill="#4fae7a"/><rect x="62" y="48" width="10" height="4" rx="2" fill="#4fae7a"/></g>
 </svg>
 <div class="lbl">澆花需要水 🌱</div>
 </div>
 <!-- 狗狗喝水 -->
 <div class="actor" style="top:66%;left:74%" onclick="act(this,'s1c')">
 <svg width="110" height="80" viewBox="0 0 110 80">
 <ellipse cx="55" cy="45" rx="30" ry="18" fill="#caa36b"/>
 <circle cx="90" cy="38" r="16" fill="#caa36b"/>
 <ellipse cx="80" cy="25" rx="6" ry="12" fill="#a87f45" transform="rotate(-20 80 25)"/>
 <circle cx="95" cy="36" r="2.5" fill="#333"/>
 <ellipse cx="96" cy="50" rx="4" ry="3" fill="#333"/>
 <rect x="30" y="58" width="50" height="10" rx="3" fill="#6fd1ef" opacity=".8"/>
 </svg>
 <div class="lbl">狗狗也要喝水 🐶</div>
 </div>
 <!-- 水龍頭 -->
 <div class="faucet-zone">
 <svg width="80" height="70" viewBox="0 0 80 70">
 <rect x="10" y="10" width="40" height="10" rx="4" fill="#9aa"/>
 <rect x="40" y="10" width="10" height="26" rx="3" fill="#9aa"/>
 <rect x="30" y="34" width="24" height="8" rx="3" fill="#778"/>
 <g id="handle" style="transform-origin:20px 10px;transition:transform .4s"><rect x="14" y="2" width="12" height="10" rx="3" fill="#2b9fc4"/></g>
 </svg>
 <div class="water-stream" id="stream"></div>
 <button class="btn" id="faucetBtn" style="margin-top:10px;opacity:.5;pointer-events:none" onclick="openFaucet()">打開水龍頭 💧</button>
 </div>
 </div>
 </section>

 <!-- 第二站 -->
 <section class="scene" id="s2">
 <div class="hud">
 <div class="title"><h2>第二站 · 下水道與汙水處理廠</h2><p>幫忙清除水中的雜質</p></div>
 <div class="tip">點擊垃圾清除它，並移動滑鼠攪動水流讓雜質沉澱</div>
 </div>
 <canvas id="c2"></canvas>
 <div class="progress"><i id="p2"></i></div>
 <div class="nextwrap" id="n2"><button class="btn" onclick="go('s3')">水變乾淨了，流向河川 →</button></div>
 </section>

 <!-- 第三站 -->
 <section class="scene" id="s3">
 <div class="hud">
 <div class="title"><h2>第三站 · 河川與水庫</h2><p>移動滑鼠，感受水的流動</p></div>
 <div class="tip">在水面上移動游標，製造波紋、帶動水流與魚群</div>
 </div>
 <canvas id="c3"></canvas>
 <div class="nextwrap on" style="bottom:28px"><button class="btn ghost" onclick="go('end')">完成旅程 →</button></div>
 </section>

 <!-- 結尾 -->
 <section class="scene" id="end">
 <div class="drop"></div>
 <h1>水，回到了自然</h1>
 <p>水不只是被使用，更會重新回到河川與水庫，繼續循環。<br>珍惜每一次用水，就是守護每一滴水的未來。</p>
 <button class="btn" onclick="location.reload()">再玩一次 ↺</button>
 </section>

</div>

<script>
/* ========= 場景切換 ========= */
let s2started=false, s3started=false;
function go(id){
 const fade=document.getElementById('fade');
 fade.classList.add('on');
 setTimeout(()=>{
 document.querySelectorAll('.scene').forEach(s=>s.classList.remove('active'));
 document.getElementById(id).classList.add('active');
 if(id==='s2'&&!s2started){s2started=true;initS2();}
 if(id==='s3'&&!s3started){s3started=true;initS3();}
 fade.classList.remove('on');
 },500);
}

/* ========= 第一站 ========= */
let clicked=new Set();
function act(el,key){
 el.classList.add('show');
 clicked.add(key);
 const tip=document.getElementById('s1tip');
 if(clicked.size>=3){
 tip.textContent='很好！現在打開水龍頭吧 👇';
 const b=document.getElementById('faucetBtn');
 b.style.opacity='1'; b.style.pointerEvents='auto';
 } else {
 tip.textContent=`已認識 ${clicked.size}/3 個角色`;
 }
}
function openFaucet(){
 document.getElementById('handle').style.transform='rotate(-70deg)';
 document.getElementById('stream').style.height='120px';
 document.getElementById('faucetBtn').style.pointerEvents='none';
 setTimeout(()=>go('s2'),1300);
}

/* ========= 第二站：汙水處理 ========= */
function initS2(){
 const cv=document.getElementById('c2'), x=cv.getContext('2d');
 function size(){cv.width=cv.clientWidth; cv.height=cv.clientHeight;}
 size(); window.addEventListener('resize',size);
 let dirt=[], total=22, cleaned=0, mouse={x:-99,y:-99};
 const colors=['#5c7a4a','#7a5a3a','#444','#6b5b3a'];
 for(let i=0;i<total;i++){
 dirt.push({x:Math.random()*cv.width,y:Math.random()*cv.height*0.7+40,
 r:8+Math.random()*14,vy:.2+Math.random()*.4,vx:(Math.random()-.5)*.4,
 c:colors[i%colors.length],dead:false,sink:0});
 }
 cv.addEventListener('mousemove',e=>{const b=cv.getBoundingClientRect();mouse.x=e.clientX-b.left;mouse.y=e.clientY-b.top;});
 cv.addEventListener('mouseleave',()=>{mouse.x=-99;mouse.y=-99;});
 cv.addEventListener('click',e=>{
 const b=cv.getBoundingClientRect(),mx=e.clientX-b.left,my=e.clientY-b.top;
 dirt.forEach(d=>{ if(!d.dead && Math.hypot(d.x-mx,d.y-my)<d.r+8){ d.dead=true; cleaned++; update(); }});
 });
 function update(){
 const pct=Math.min(100,Math.round(cleaned/total*100));
 document.getElementById('p2').style.width=pct+'%';
 if(cleaned>=total){ document.getElementById('n2').classList.add('on'); }
 }
 let clean=0;
 function loop(){
 clean=cleaned/total;
 // 水背景：隨淨化變清澈
 const dirtyCol=`rgb(${60+clean*100},${70+clean*120},${50+clean*160})`;
 x.fillStyle=dirtyCol; x.fillRect(0,0,cv.width,cv.height);
 // 水波
 x.strokeStyle='rgba(255,255,255,'+(.08+clean*.15)+')';
 for(let k=0;k<4;k++){x.beginPath();for(let i=0;i<cv.width;i+=12){x.lineTo(i,100+k*120+Math.sin(i*.02+Date.now()*.002+k)*8);}x.stroke();}
 // 雜質
 dirt.forEach(d=>{
 if(d.dead){ d.sink+=4; if(d.y+d.sink<cv.height+40){ drawDirt(d,d.sink,.5);} return;}
 // 滑鼠攪動：把雜質往下推（沉澱）
 const dist=Math.hypot(d.x-mouse.x,d.y-mouse.y);
 if(dist<70){ d.vy+=.15; d.x+=(d.x-mouse.x)/dist*1.2; }
 d.x+=d.vx; d.y+=d.vy; d.vy*=.985;
 if(d.y>cv.height-30){d.y=cv.height-30;d.vy*=-.3;}
 if(d.x<0||d.x>cv.width)d.vx*=-1;
 drawDirt(d,0,1);
 });
 function drawDirt(d,off,a){x.globalAlpha=a;x.fillStyle=d.c;x.beginPath();x.arc(d.x,d.y+off,d.r,0,7);x.fill();x.globalAlpha=1;}
 if(document.getElementById('s2').classList.contains('active')) requestAnimationFrame(loop);
 else requestAnimationFrame(loop);
 }
 loop();
}

/* ========= 第三站：河川流動 ========= */
function initS3(){
 const cv=document.getElementById('c3'), x=cv.getContext('2d');
 function size(){cv.width=cv.clientWidth; cv.height=cv.clientHeight;}
 size(); window.addEventListener('resize',size);
 let t=0, mouse={x:-99,y:-99,active:false}, ripples=[], fish=[];
 for(let i=0;i<6;i++)fish.push({x:Math.random()*cv.width,y:cv.height*0.55+Math.random()*cv.height*0.3,s:.6+Math.random()*.6,dir:Math.random()<.5?1:-1});
 cv.addEventListener('mousemove',e=>{const b=cv.getBoundingClientRect();mouse.x=e.clientX-b.left;mouse.y=e.clientY-b.top;mouse.active=true;
 if(Math.random()<.3)ripples.push({x:mouse.x,y:mouse.y,r:2,max:40+Math.random()*30});});
 cv.addEventListener('mouseleave',()=>mouse.active=false);
 function loop(){
 t+=.02;
 // 天空
 let g=x.createLinearGradient(0,0,0,cv.height*.5);g.addColorStop(0,'#bfeef7');g.addColorStop(1,'#e6f7ff');
 x.fillStyle=g;x.fillRect(0,0,cv.width,cv.height*.55);
 // 遠山
 x.fillStyle='#9ec9a0';x.beginPath();x.moveTo(0,cv.height*.55);
 for(let i=0;i<=cv.width;i+=40)x.lineTo(i,cv.height*.4+Math.sin(i*.01)*30);
 x.lineTo(cv.width,cv.height*.55);x.fill();
 // 河水
 let wg=x.createLinearGradient(0,cv.height*.5,0,cv.height);wg.addColorStop(0,'#6fd1ef');wg.addColorStop(1,'#2b8fc4');
 x.fillStyle=wg;x.fillRect(0,cv.height*.5,cv.width,cv.height*.5);
 // 流動波紋線
 for(let k=0;k<6;k++){
 x.strokeStyle='rgba(255,255,255,'+(.25-k*.02)+')';x.lineWidth=2;x.beginPath();
 const yb=cv.height*.55+k*((cv.height*.45)/6);
 for(let i=0;i<=cv.width;i+=10){
 let off=Math.sin(i*.02+t+k)*6;
 if(mouse.active){const d=Math.hypot(i-mouse.x,yb-mouse.y);if(d<120)off+=Math.sin(d*.1-t*3)*(120-d)*.15;}
 x.lineTo(i,yb+off);
 }
 x.stroke();
 }
 // 游標波紋
 ripples.forEach((rp,i)=>{rp.r+=1.5;x.strokeStyle='rgba(255,255,255,'+(1-rp.r/rp.max)*.5+')';x.lineWidth=2;x.beginPath();x.arc(rp.x,rp.y,rp.r,0,7);x.stroke();if(rp.r>rp.max)ripples.splice(i,1);});
 // 魚
 fish.forEach(f=>{
 f.x+=f.dir*f.s;
 if(mouse.active){const d=Math.hypot(f.x-mouse.x,f.y-mouse.y);if(d<100){f.x+=(f.x-mouse.x)/d*2;f.y+=(f.y-mouse.y)/d*1;}}
 if(f.x>cv.width+20)f.x=-20;if(f.x<-20)f.x=cv.width+20;
 f.y=Math.max(cv.height*.56,Math.min(cv.height*.95,f.y));
 x.fillStyle='#ff8c42';x.save();x.translate(f.x,f.y);x.scale(f.dir,1);
 x.beginPath();x.ellipse(0,0,12,6,0,0,7);x.fill();
 x.beginPath();x.moveTo(-12,0);x.lineTo(-20,-6);x.lineTo(-20,6);x.fill();x.restore();
 });
 if(document.getElementById('s3').classList.contains('active'))requestAnimationFrame(loop);
 else requestAnimationFrame(loop);
 }
 loop();
}
</script>
</body>
</html>
